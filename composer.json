{
    "name": "tornado-engine/access-microsoft-entra",
    "description": "Tornado Engine module: gives roles to Entra ID groups and users, synced nightly.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "illuminate/support": "^13.0",
        "tornado-engine/access": ">=0.8",
        "tornado-engine/cron": ">=0.4"
    },
    "autoload": {
        "psr-4": {
            "TornadoEngine\\AccessMicrosoftEntra\\": "src/"
        }
    },
    "extra": {
        "tornado": {
            "name": "Access-Microsoft-Entra",
            "prompt": "Entra ID: modules read it through TornadoEngine\\AccessMicrosoftEntra\\Graph (users, group members) when they need it, rather than keeping their own copy.",
            "core": ">=0.21",
            "core-module": false,
            "suggest": true,
            "provider": "TornadoEngine\\AccessMicrosoftEntra\\AccessMicrosoftEntraServiceProvider",
            "settings": "/access/entra-id",
            "needs-setup": true,
            "setup-done": "TornadoEngine\\AccessMicrosoftEntra\\Graph@configured"
        },
        "branch-alias": {
            "dev-main": "0.3.x-dev"
        }
    }
}
